{
  "name": "preflight",
  "version": "0.2.0",
  "description": "Know what an AI-written IT workflow will do before it runs.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "preflight": "dist/cli.mjs" },
  "scripts": {
    "build": "esbuild src/cli.ts src/router.ts --bundle --platform=node --format=esm --outdir=dist --out-extension:.js=.mjs --external:typescript --log-level=warning",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/run.mjs",
    "route": "node dist/router.mjs"
  },
  "dependencies": { "typescript": "5.6.3" },
  "devDependencies": { "esbuild": "0.24.0", "@types/node": "22.10.2" }
}
